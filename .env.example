# Telegram Bot Token (from @BotFather)
TOKEN=your_telegram_bot_token_here

# Bot Username (without @)
BOTNAME=ciwokBot

# MongoDB Atlas Connection
DB_USER=your_mongodb_username
DB_PW=your_mongodb_password
DB_NAME=ciwok_bot

# WordPress username (for Application Password Basic auth)
WP_USER=your_wp_username

# WordPress Application Password (24 chars, spaces optional)
CLIENT_TOKEN=your_app_password_here

# API URL for sending tasks (default: WordPress endpoint)
API_URL=https://scc.ciwok.com/wp-json/jet-cct/comisiones_dec

# Optional: Port for Express server (default: 8000)
# PORT=8000
